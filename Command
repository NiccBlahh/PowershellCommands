<!DOCTYPE html>
<html>
<head>
    <title>Rhythia Web UI</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #0d1117; color: white; text-align: center; margin-top: 100px; }
        h1 { color: #58a6ff; }
        button { font-size: 24px; font-weight: bold; padding: 15px 40px; margin: 15px; cursor: pointer; border-radius: 8px; border: none; transition: 0.2s; }
        button:hover { transform: scale(1.05); }
        #startBtn { background: #238636; color: white; }
        #stopBtn { background: #da3633; color: white; }
        #exitBtn { background: #30363d; color: white; margin-top: 50px; font-size: 18px; }
        .status { font-size: 24px; margin: 30px; font-weight: bold; color: #ff7b72; }
    </style>
    <script>
        const API = 'http://127.0.0.1:8080';
        function sendCmd(cmd) {
            fetch(API + cmd).then(() => updateStatus()).catch(e => console.log("Make sure the .exe is running!"));
        }
        function updateStatus() {
            fetch(API + '/status')
                .then(r => r.text())
                .then(t => {
                    let el = document.getElementById('stat');
                    el.innerText = 'Status: ' + t;
                    el.style.color = t.includes('Active') ? '#3fb950' : '#ff7b72';
                })
                .catch(e => {
                    let el = document.getElementById('stat');
                    el.innerText = 'Status: Disconnected (Is the background .exe running?)';
                    el.style.color = '#ff7b72';
                });
        }
        setInterval(updateStatus, 1000);
    </script>
</head>
<body onload="updateStatus()">
    <h1>Rhythia Aimbot Panel</h1>
    <div class="status" id="stat">Status: Loading...</div>
    <button id="startBtn" onclick="sendCmd('/start')">▶ START MACRO</button>
    <button id="stopBtn" onclick="sendCmd('/stop')">⏸ STOP MACRO</button>
    <br>
    <button id="exitBtn" onclick="sendCmd('/exit')">✖ CLOSE APP COMPLETELY</button>
</body>
</html>
