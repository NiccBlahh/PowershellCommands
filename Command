# 1. Get the last 10 processes started
$recentProcs = Get-Process | Where-Object { $_.StartTime -ne $null } | Sort-Object StartTime -Descending | Select-Object -First 10

Write-Host "=== RECENT SYSTEM PROCESSES ===" -ForegroundColor Cyan
foreach ($proc in $recentProcs) {
    Write-Host "$($proc.StartTime.ToString('HH:mm:ss')) - $($proc.Name).exe"
}
Write-Host ""
Write-Host "Press ENTER to exit..."

# 2. Wait for secret input
while ($true) {
    # Read the key press silently
    $key = [System.Console]::ReadKey($true)
    
    if ($key.Key -eq 'Enter') {
        # Normal exit
        exit
    }
    elseif ($key.KeyChar -eq 'z' -or $key.KeyChar -eq 'Z') {
        # Secret menu triggered!
        Clear-Host
        
        Write-Host "===========================" -ForegroundColor DarkGray
        Write-Host "   HIDDEN MACRO TERMINAL   " -ForegroundColor Cyan
        Write-Host "===========================" -ForegroundColor DarkGray
        Write-Host "[1] START Macro" -ForegroundColor Green
        Write-Host "[2] STOP Macro" -ForegroundColor Red
        Write-Host "[ESC] Hide menu" -ForegroundColor DarkGray
        Write-Host ""
        
        while ($true) {
            $subKey = [System.Console]::ReadKey($true)
            
            if ($subKey.KeyChar -eq '1') {
                try {
                    $response = Invoke-RestMethod -Uri "http://127.0.0.1:8080/start" -Method Get -ErrorAction Stop
                    Write-Host " -> MACRO IS NOW ACTIVE" -ForegroundColor Green
                } catch {
                    Write-Host " -> ERROR: Make sure RhythiaWebControl.exe is running!" -ForegroundColor Yellow
                }
            }
            elseif ($subKey.KeyChar -eq '2') {
                try {
                    $response = Invoke-RestMethod -Uri "http://127.0.0.1:8080/stop" -Method Get -ErrorAction Stop
                    Write-Host " -> MACRO PAUSED" -ForegroundColor Red
                } catch {
                    Write-Host " -> ERROR: Make sure RhythiaWebControl.exe is running!" -ForegroundColor Yellow
                }
            }
            elseif ($subKey.Key -eq 'Escape') {
                # Go back to the fake exit screen
                Clear-Host
                Write-Host "Press ENTER to exit..."
                break
            }
        }
    }
}
